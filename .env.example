NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./data/geoeco.sqlite3
REDIS_URL=
JOB_EXECUTION_MODE=in_process
QUEUE_NAME=geoeco
QUEUE_MAX_JOBS=20
WORKER_CONCURRENCY=1
RQ_DEFAULT_TIMEOUT=3600
RQ_ANALYSIS_TIMEOUT=3600
RQ_COMPARISON_TIMEOUT=7200
RQ_REPORT_TIMEOUT=1200
STAC_URL=https://earth-search.aws.element84.com/v1
STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-c1-l2a
MAX_ZONE_AREA_KM2=5000
MAX_ZONE_AREA_SQ_KM=5000
MAX_ANALYSIS_DAYS=140
MAX_DATE_RANGE_DAYS=140
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_ANALYSES=1
DATA_DIR=./data
STORAGE_ROOT=./data
RASTER_STORAGE_DIR=
REPORT_STORAGE_DIR=
CACHE_STORAGE_DIR=
TILE_CACHE_ENABLED=true
