PUBLIC_DOMAIN=:80
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=geoeco
POSTGRES_USER=geoeco
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://geoeco:change-me@postgres:5432/geoeco
REDIS_URL=redis://redis:6379/0

APP_ENV=production
CORS_ALLOWED_ORIGINS=
JOB_EXECUTION_MODE=rq
QUEUE_NAME=geoeco
QUEUE_MAX_JOBS=20
WORKER_CONCURRENCY=1
RQ_DEFAULT_TIMEOUT=3600
RQ_ANALYSIS_TIMEOUT=3600
RQ_COMPARISON_TIMEOUT=7200
RQ_REPORT_TIMEOUT=1200
STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-c1-l2a
STORAGE_ROOT=/data
RASTER_STORAGE_DIR=/data/rasters
REPORT_STORAGE_DIR=/data/reports
CACHE_STORAGE_DIR=/data/cache
TILE_CACHE_ENABLED=true
MAX_ZONE_AREA_SQ_KM=5000
MAX_ANALYSIS_DAYS=140
MAX_DATE_RANGE_DAYS=140
MAX_CONCURRENT_ANALYSES=1

NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
