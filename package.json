{
  "name": "geoeco-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "GeoEco Monitor: публичный аналитический дашборд дистанционной экологической оценки по Sentinel-2.",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
